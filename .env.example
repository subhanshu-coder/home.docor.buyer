# Apollo.io — company + contact search, and email enrichment for buyers
# Get / manage keys: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=Cx1-CM3VoUXy3M_8PQRXEA

# Google Places API — alternative source for candidate buyer businesses
# Get a key: https://console.cloud.google.com/apis/credentials (enable "Places API")
GOOGLE_PLACES_API_KEY=

# Hunter.io — used to find a verified contact email for a business's website domain
# Get a key: https://hunter.io/api-keys (free tier: 25 searches/month)
HUNTER_API_KEY=

# SendGrid — used to actually send the outreach emails
# Get a key: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=you@yourdomain.com

# Used to build the unsubscribe link inside every outreach email
PUBLIC_BASE_URL=http://localhost:3000

PORT=3000
